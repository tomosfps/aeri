# Discord token, required to start the bot
DISCORD_TOKEN="..."
# Discord Bot Application ID, required to start the bot
DISCORD_APPLICATION_ID="..."
# Discord test guild ID, optional, used for testing slash commands
DISCORD_TEST_GUILD_ID="..."
# Discord owner IDs, optional but recommended, 
# used for commands that require owner permissions
DISCORD_OWNER_IDS=123, 123

# Anilist client ID, required to access the Anilist API
ANILIST_CLIENT_ID="..."
# Anilist client secret, required to access the Anilist API
ANILIST_CLIENT_SECRET="..."
# Anilist redirect URL, required to access the Anilist API
ANILIST_REDIRECT_URL="http://localhost:8080/oauth/anilist"

# Postgres hostname, optional, used to connect to the database
# If you are using docker, this should be the name of the service in docker-compose.yml
POSTGRES_HOST="localhost"
# Postgres port, default is 5432, optional
POSTGRES_PORT=5432
# Postgres username, default is admin, optional
POSTGRES_USER=admin
# Postgres password, default is root, optional
POSTGRES_PASSWORD=root
# Postgres database, default is bot, optional
POSTGRES_DB=bot
# Postgres URL, uses the above values to create a URL, required
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=db"

# API IP, required to access the API
# usually the name of the service within docker-compise.yml
API_HOST=localhost
# API Port, required to access the API
API_PORT=8080
# API URL, not required, but can be used to access the API through bot commands
API_URL="http://${API_HOST}:${API_PORT}"
# Proxy URL for the API, this is required to make requests.
# Must be a URL to a JSON of proxies. You can use the one below, or host your own.
MAIN_PROXIES="https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/all/data.json"
BACKUP_PROXIES="https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/http/data.json"

# API URL for the frontend, this is required to access the API through the frontend
VITE_API_URL="${API_URL}"
# Discord support server invite link, optional
VITE_DISCORD_SUPPORT_INVITE="undefined"
# Discord support server invite link, optional
# This is used to generate the invite link for the bot
VITE_DISCORD_APPLICATION_ID="${DISCORD_APPLICATION_ID}"
# Discord support server invite link, optional
# This is used to generate the invite link for the bot
VITE_DISCORD_INVITE_PERMISSIONS=8

# Redis hostname, usually the name of the service in docker-compose.yml, default is localhost, optional
REDIS_HOST="localhost"
# Redis port, default is 6379, optional
REDIS_PORT=6379
# Redis password, default is none, optional
REDIS_PASSWORD=""
# Redis database, default is 0, optional
REDIS_DATABASE=0
# Redis URL, used within the API
REDIS_URL="redis://${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DATABASE}"

# The URL of the website
WEBSITE_URL=http://localhost:5173
# The OAuth success path
OAUTH_SUCCESS_PATH=/success
# The OAuth fail path
OAUTH_FAIL_PATH=/fail

# Shard count, required
SHARD_COUNT=2
# Shards per worker, required
SHARDS_PER_WORKER=8

# Port to publish metrics on, default is 9091, optional
GATEWAY_METRICS_PORT=9091
# Prometheus URL
PROMETHEUS_URL="http://0.0.0.0:9090/"
# Grafana admin user, default is admin, optional
GF_SECURITY_ADMIN_USER=admin
# Grafana admin password, default is admin, optional
GF_SECURITY_ADMIN_PASSWORD=admin

# Log level, default is 3, optional
# 0 = Fatal, 1 = Error, 2 = Warn, 3 = Info, 4 = Debug, 5 = Silly
LOG_LEVEL=4